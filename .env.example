# ── AIS Portal Credentials ────────────────────────────────────────────────────
# Your login for ais.usvisa-info.com
VISA_USERNAME=your.email@example.com
VISA_PASSWORD=yourpassword

# ── Consulate Selection ───────────────────────────────────────────────────────
# Two-letter country code used in the AIS URL (en-in = India, en-gb = UK, etc.)
COUNTRY_CODE=in

# City name — used in log messages and email alerts
CONSUL_CITY=Chennai

# AIS Facility ID for your target consulate (India):
#   Chennai   = 89
#   Mumbai    = 90
#   Hyderabad = 91
#   Delhi     = 92
#   Kolkata   = 93
FACILITY_ID=89

# ── Schedule ID ───────────────────────────────────────────────────────────────
# Find this in your AIS dashboard URL after login:
#   https://ais.usvisa-info.com/en-in/niv/schedule/<SCHEDULE_ID>/appointment
# Leave blank to let the agent auto-discover it from the dashboard.
SCHEDULE_ID=

# ── Preferred Date Range ──────────────────────────────────────────────────────
# Alert only for slots within this window. Leave blank to alert for any date.
PREFERRED_DATE_FROM=2025-07-01
PREFERRED_DATE_TO=2025-12-31

# ── Polling Interval ──────────────────────────────────────────────────────────
# How often to check for new slots (minutes). Recommended: 10–30.
# Very short intervals (< 5 min) may trigger rate limiting on the portal.
CHECK_INTERVAL_MINUTES=15

# ── Email Notifications ───────────────────────────────────────────────────────
# Address that will receive slot-found alerts
NOTIFY_EMAIL=your.email@example.com

# Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# Other providers: adjust SMTP_SERVER / SMTP_PORT accordingly
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.gmail@gmail.com
SMTP_PASSWORD=your_app_password_here
